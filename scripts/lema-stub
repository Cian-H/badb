#!/usr/bin/env -S guile --no-auto-compile -s
!#
;; scripts/lema-stub — stub Lema contract-oracle server.
;;
;; A test double for the real Lema store/server (which does not exist
;; yet). Implements the seam protocol documented authoritatively in
;; src/badb/lema.scm: a UNIX-domain socket speaking newline-delimited
;; JSON, one request object per line, one response object per line.
;; The store is in-memory (lost on exit), which is all the unit tests
;; need.
;;
;; Socket path resolution: the first command-line argument, else
;; $BADB_LEMA_SOCKET, else the documented default
;; ~/.local/share/lema/lema.sock.
;;
;; Verdict convention: SUBMIT for any contract id ending in "-fail"
;; returns verdict "failed" (so tests exercise both paths); every
;; other submitted contract returns "passed". SUBMIT for an unknown
;; contract id also fails.
;;
;; Run: scripts/lema-stub /tmp/test-lema.sock

(use-modules (json)
             (ice-9 format)
             (ice-9 rdelim)
             (srfi srfi-1)
             (srfi srfi-13))

(define %contracts (make-hash-table))
(define %verified '())
(define %errors (make-hash-table))

(define (stub-socket-path args)
  "Resolve the socket path from script ARGS, the environment, or the default."
  (or (and (pair? (cdr args))
           (string? (cadr args))
           (not (string-null? (cadr args)))
           (cadr args))
      (let ((env (getenv "BADB_LEMA_SOCKET")))
        (and env (not (string-null? env)) env))
      (string-append (or (getenv "HOME") "/tmp")
                     "/.local/share/lema/lema.sock")))

(define (handle-publish-contract! req)
  "PUBLISH-CONTRACT: store the contract record in memory."
  (let ((id (or (assoc-ref req "id") "")))
    (hash-set! %contracts id
               `((id . ,id)
                 (code . ,(or (assoc-ref req "code") ""))
                 (spec . ,(or (assoc-ref req "spec") ""))))
    '((ok . #t))))

(define (handle-submit req)
  "SUBMIT: decide the verdict by the -fail convention and record the outcome."
  (let* ((id (or (assoc-ref req "contract_id") ""))
         (contract (hash-ref %contracts id))
         (verdict
          (cond
           ((not contract) "failed")
           ((string-suffix? "-fail" id) "failed")
           (else "passed")))
         (details
          (cond
           ((not contract) (format #f "unknown contract: ~a" id))
           ((string=? verdict "failed")
            (format #f "contract ~a failed by stub convention" id))
           (else "stub verdict: passed"))))
    (if (string=? verdict "passed")
        (set! %verified (cons id %verified))
        (hash-set! %errors id
                   (cons details (or (hash-ref %errors id) '()))))
    `((verdict . ,verdict) (details . ,details))))

(define (handle-replay-errors req)
  "REPLAY-ERRORS: return the recorded error details for a contract."
  (let* ((id (or (assoc-ref req "contract_id") ""))
         (errs (reverse (or (hash-ref %errors id) '()))))
    `((errors . ,(list->vector errs)))))

(define (handle-list-verified req)
  "LIST-VERIFIED: return the ids that have passed SUBMIT."
  (let ((ids (reverse (delete-duplicates %verified))))
    `((ids . ,(list->vector ids)))))

(define (handle-get-contract req)
  "GET-CONTRACT: return the stored contract record."
  (let* ((id (or (assoc-ref req "id") ""))
         (contract (hash-ref %contracts id)))
    (if contract
        contract
        `((error . ,(format #f "unknown contract: ~a" id))))))

(define (dispatch req)
  "Dispatch one parsed protocol request REQ to its command handler."
  (let ((command (assoc-ref req "command")))
    (cond
     ((equal? command "PUBLISH-CONTRACT") (handle-publish-contract! req))
     ((equal? command "SUBMIT") (handle-submit req))
     ((equal? command "REPLAY-ERRORS") (handle-replay-errors req))
     ((equal? command "LIST-VERIFIED") (handle-list-verified req))
     ((equal? command "GET-CONTRACT") (handle-get-contract req))
     (else
      `((error . ,(format #f "unknown command: ~a" command)))))))

(define (serve-connection client)
  "Serve one connection: read request lines and write response lines until EOF."
  (let loop ()
    (let ((line (read-line client)))
      (unless (eof-object? line)
        (let ((trimmed (string-trim line)))
          (unless (string-null? trimmed)
            (catch #t
              (lambda ()
                (display (scm->json-string (dispatch (json-string->scm trimmed)))
                         client)
                (newline client))
              (lambda (key . args)
                (display (scm->json-string
                           `((error . ,(format #f "bad request (~a): ~s" key args))))
                          client)
                (newline client)))
            (force-output client))
          (loop))))))

(define (ensure-parent-dir path)
  "Ensure the parent directory of the socket PATH exists."
  (let ((dir (dirname path)))
    (unless (or (string=? dir ".") (string-null? dir) (file-exists? dir))
      (catch 'system-error
        (lambda () (mkdir dir))
        (lambda _ #f)))))

(define (serve path)
  "Bind PATH and accept connections forever (until killed)."
  (when (file-exists? path) (delete-file path))
  (ensure-parent-dir path)
  (let ((sock (socket AF_UNIX SOCK_STREAM 0)))
    (bind sock AF_UNIX path)
    (listen sock 16)
    (format (current-error-port) "lema-stub: listening on ~a~%" path)
    (let loop ()
      (let ((client (accept sock)))
        (catch #t
          (lambda () (serve-connection (car client)))
          (lambda (key . args)
            (format (current-error-port)
                    "lema-stub: connection error: ~a ~s~%" key args)))
        (catch #t
          (lambda () (close-port (car client)))
          (lambda _ #f))
        (loop)))))

(serve (stub-socket-path (command-line)))
