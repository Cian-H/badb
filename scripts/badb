#!/usr/bin/env -S guile -e main -s
!#
;; badb launcher: puts src/ on the load path, adds the geis bundle search
;; roots (BADB_GEIS_PATH, default "geis") so (geis <fid> plugin) modules
;; resolve as raw scheme, and imports the real entry point from (badb main)
;; so that `guile -e main' can find it.
(add-to-load-path
 (canonicalize-path
  (string-append (dirname (current-filename)) "/../src")))
(add-to-load-path
 (canonicalize-path
  (string-append (dirname (current-filename)) "/..")))
(let ((geis-path (getenv "BADB_GEIS_PATH")))
  (for-each
   (lambda (root)
     (unless (or (not root) (string-null? root))
       (catch #t
         (lambda () (add-to-load-path root))
         (lambda _ #f))))
   (if (or (not geis-path) (string-null? geis-path))
       '("geis")
       (string-split geis-path #\:))))
(use-modules (badb main))
