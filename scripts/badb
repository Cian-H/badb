#!/usr/bin/env -S guile -e main -s
!#
;; badb launcher: puts src/ on the load path and imports the real
;; entry point from (badb main) so that `guile -e main' can find it.
(add-to-load-path
 (canonicalize-path
  (string-append (dirname (current-filename)) "/../src")))
(add-to-load-path
 (canonicalize-path
  (string-append (dirname (current-filename)) "/..")))
(use-modules (badb main))
