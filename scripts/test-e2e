#!/bin/sh
# Runs the tui-test based e2e suite for the badb TUI.
#
# Must run inside the project's guix dev environment (tui-test and
# guile-ncurses only exist there):
#
#   ./scripts/devenv -- ./scripts/test-e2e
#
# All scenarios are hermetic; the chat round-trip runs against the
# static fake endpoint in test/e2e/fake-endpoint.scm by default. To
# exercise a real model server instead:
#
#   E2E_CHAT_ENDPOINT=http://127.0.0.1:1234/v1 \
#   E2E_CHAT_MODEL=qwen/qwen3.6-35b-a3b \
#   ./scripts/devenv -- ./scripts/test-e2e
ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

if ! command -v tui-test >/dev/null 2>&1; then
  echo "error: tui-test not on PATH; run inside ./scripts/devenv" >&2
  exit 2
fi

# Clear any stale sessions and daemons so scenarios start from a clean
# slate (session daemons inherit the environment of the first client
# that spawned them).
tui-test close --all >/dev/null 2>&1
tui-test daemon stop --all >/dev/null 2>&1

fails=0
total=0
for scenario in "$ROOT_DIR"/test/e2e/[0-9]*.sh; do
  echo "=== $(basename "$scenario")"
  sh "$scenario"
  rc=$?
  total=$((total + 1))
  if [ "$rc" -ne 0 ]; then
    fails=$((fails + 1))
  fi
done

tui-test close --all >/dev/null 2>&1
tui-test daemon stop --all >/dev/null 2>&1

echo ""
echo "e2e: $((total - fails))/$total scenarios passed"
[ "$fails" -eq 0 ]
