#!/usr/bin/env -S guile -e main -s
!#
;;; test-e2e — Unified End-to-End Test Suite Runner (Integration + TUI)
;;;
;;; Usage:
;;;   ./scripts/test-e2e [options]
;;;
;;; Options:
;;;   --all, -a           Run integration suites and TUI scenarios (default)
;;;   --integration, -i   Run only non-TUI integration suites
;;;   --tui, -t           Run only terminal TUI scenarios

(setenv "GUILE_AUTO_COMPILE" "0")

(define %script-path
  (canonicalize-path (car (command-line))))

(define %root-dir
  (canonicalize-path (string-append (dirname %script-path) "/..")))

(set! %load-path (cons (string-append %root-dir "/src") %load-path))
(set! %load-path (cons %root-dir %load-path))

;; Re-exec through devenv if guix/project dependencies are not on load path
(unless (catch #t
          (lambda () (resolve-interface '(fslib)) #t)
          (lambda _ #f))
  (let ((devenv (string-append %root-dir "/scripts/devenv")))
    (apply execl devenv devenv "--" %script-path (cdr (command-line)))))

(use-modules (ice-9 ftw)
             (ice-9 format)
             (ice-9 match)
             (srfi srfi-1))

(define (utc-timestamp)
  (strftime "%Y-%m-%dT%H:%M:%SZ" (gmtime (current-time))))

(define (run-sub-suite name cmd-args)
  (format #t ">> Running: ~a~%" name)
  (let ((status (apply system* cmd-args)))
    (if (zero? (status:exit-val status))
        (begin
          (format #t ">> PASSED: ~a~%~%" name)
          0)
        (begin
          (format (current-error-port) ">> FAILED: ~a (exit code ~a)~%~%"
                  name (status:exit-val status))
          1))))

(define (run-integration-stage)
  (display "-----------------------------------------------------------------\n")
  (display ">>> Stage 1: Integration & Subsystem E2E Suites\n")
  (display "-----------------------------------------------------------------\n")
  (+ (run-sub-suite "CLI Entrypoints"
                    '("./test/e2e/test-cli-entrypoints.sh"))
     (run-sub-suite "Geis Contract Locking & Verification"
                    '("guile" "-L" "src" "-L" "." "./test/e2e/test-geis-contract.scm"))
     (run-sub-suite "Transaction Rollback & Provenance"
                    '("guile" "-L" "src" "-L" "." "./test/e2e/test-transaction-rollback.scm"))))

(define (cleanup-tui-sessions)
  (catch #t
    (lambda ()
      (system* "tui-test" "close" "--all")
      (system* "tui-test" "daemon" "stop" "--all"))
    (lambda _ #f)))

(define (find-tui-scenarios)
  (let ((dir (string-append %root-dir "/test/e2e")))
    (if (file-exists? dir)
        (sort
         (filter-map
          (lambda (name)
            (and (string-suffix? ".sh" name)
                 (let ((c (string-ref name 0)))
                   (char-numeric? c))
                 (string-append "test/e2e/" name)))
          (scandir dir (lambda (n) (not (member n '("." ".."))))))
         string<?)
        '())))

(define (run-tui-stage)
  (display "-----------------------------------------------------------------\n")
  (display ">>> Stage 2: Interactive TUI Scenarios (tui-test)\n")
  (display "-----------------------------------------------------------------\n")
  (unless (search-path (parse-path (or (getenv "PATH") "")) "tui-test")
    (format (current-error-port) "error: tui-test not on PATH; run inside ./scripts/devenv~%")
    (exit 2))

  (cleanup-tui-sessions)

  (let* ((scenarios (find-tui-scenarios))
         (results
          (map
           (lambda (scenario)
             (format #t "=== ~a~%" (basename scenario))
             (let ((status (system* "sh" scenario)))
               (zero? (status:exit-val status))))
           scenarios))
         (total (length scenarios))
         (passes (count identity results))
         (fails (- total passes)))
    (cleanup-tui-sessions)
    (format #t "~%TUI E2E: ~a/~a scenarios passed~%" passes total)
    fails))

(define (main args)
  (chdir %root-dir)
  (let* ((mode (match (cdr args)
                 ((m . _) m)
                 (() "--all")))
         (run-integration? (member mode '("--all" "-a" "--integration" "-i")))
         (run-tui? (member mode '("--all" "-a" "--tui" "-t"))))

    (display "=================================================================\n")
    (display "       badb Microkernel End-to-End (E2E) Test Suite              \n")
    (display "=================================================================\n")
    (format #t "Start time: ~a~%" (utc-timestamp))
    (format #t "Root directory: ~a~%~%" %root-dir)

    (let* ((int-fails (if run-integration? (run-integration-stage) 0))
           (tui-fails (if run-tui? (run-tui-stage) 0))
           (total-fails (+ int-fails tui-fails)))

      (display "=================================================================\n")
      (display "                    E2E Test Run Complete                        \n")
      (display "=================================================================\n")
      (if (zero? total-fails)
          (begin
            (display "ALL E2E TESTS PASSED (0 failures).\n")
            (format #t "End time: ~a~%" (utc-timestamp))
            (exit 0))
          (begin
            (format (current-error-port) "FAILED: ~a failure(s) in E2E suite.~%" total-fails)
            (format (current-error-port) "End time: ~a~%" (utc-timestamp))
            (exit 1))))))
