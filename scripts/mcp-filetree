#!/usr/bin/env -S guile -e main -s
!#
;; mcp-filetree launcher: puts src/ on the load path so the filetree
;; MCP server can serve the current working directory over stdio.
(add-to-load-path
 (canonicalize-path
  (string-append (dirname (current-filename)) "/../src")))
(use-modules (badb filetree-mcp))

(define (main args)
  (run-filetree-mcp))
