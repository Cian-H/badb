(define-module (test surfaces-notify-spec)
               #:use-module (srfi srfi-64)
               #:use-module (ice-9 threads)
               #:use-module (badb spec)
               #:use-module (geasa surfaces-overlay plugin)
               #:use-module (geasa surfaces-widgets plugin)
               #:use-module (geasa surfaces-notify plugin))

(spec-begin "surfaces-notify")

(test-group "notification-bus-and-ttl"
            (clear-notifications!)
            (parameterize ((current-notify-clock (lambda () 1000)))
                          (let ((id1 (notify-info! "Info message" #:title "Build" #:source "test"))
                                (id2 (notify-warn! "Warn message"))
                                (id3 (notify-error! "Error message")))
                            (test-assert "ids are strings" (and (string? id1) (string? id2) (string? id3)))
                            (test-equal "3 active notifications" 3 (length (notify-active)))
                            (test-equal "3 history notifications" 3 (length (notify-history)))
                            (notify-tick! 1004)
                            (test-equal "info expires at +4s" 2 (length (notify-active)))
                            (notify-tick! 1006)
                            (test-equal "warn expires at +6s" 1 (length (notify-active)))
                            (notify-tick! 1010)
                            (test-equal "error expires at +10s" 0 (length (notify-active)))
                            (test-equal "history still retains all 3" 3 (length (notify-history)))))
            (clear-notifications!))

(test-group "progress-and-resolve"
            (clear-notifications!)
            (let ((now 2000))
              (parameterize ((current-notify-clock (lambda () now)))
                            (notify-progress! "upd-1" "Checking updates..." #:title "Geasa" #:source "updater")
                            (let ((p1 (car (notify-active))))
                              (test-equal "level is progress" 'progress (notification-level p1))
                              (test-equal "initial spinner frame 0" 0 (notification-spinner-frame p1))
                              (test-equal "progress ttl is #f" #f (notification-ttl-seconds p1)))
                            (notify-tick! 2050)
                            (test-equal "progress does not expire at +50s" 1 (length (notify-active)))
                            (test-equal "spinner advances on tick" 1 (notification-spinner-frame (car (notify-active))))
                            (set! now 2055)
                            (notify-resolve! "upd-1" "2 updates applied" #:level 'info)
                            (let ((r1 (car (notify-active))))
                              (test-equal "resolved level is info" 'info (notification-level r1))
                              (test-equal "resolved ttl is 4" 4 (notification-ttl-seconds r1)))
                            (notify-tick! 2058)
                            (test-equal "resolved still active at +3s" 1 (length (notify-active)))
                            (notify-tick! 2059)
                            (test-equal "resolved expires at +4s" 0 (length (notify-active)))
                            (test-equal "history has single updated entry" 1 (length (notify-history)))))
            (clear-notifications!))

(test-group "history-cap-and-concurrency"
            (clear-notifications!)
            (parameterize ((current-notify-clock (lambda () 3000)))
                          (let ((threads
                                  (map (lambda (t)
                                         (call-with-new-thread
                                           (lambda ()
                                             (let loop ((i 0))
                                                       (when (< i 30)
                                                         (notify-info! (format #f "msg-~a-~a" t i))
                                                         (loop (+ i 1)))))))
                                       '(1 2 3 4))))
                            (for-each join-thread threads))
                          (test-equal "history capped at 100" 100 (length (notify-history))))
            (clear-notifications!))

(test-group "osc-desktop-notify"
            (let ((esc (string (integer->char 27)))
                  (bel (string (integer->char 7))))
              (test-equal "osc9 format"
                          (string-append esc "]9;badb: Turn finished" bel)
                          (format-osc-desktop-notify "badb" "Turn finished" #:style 'osc9))
              (test-equal "osc777 format sanitizes semicolons"
                          (string-append esc "]777;notify;badb:alert;Done: ok" bel)
                          (format-osc-desktop-notify "badb;alert" "Done; ok" #:style 'osc777))))

(test-group "floating-toast-overlay"
            (clear-notifications!)
            (let* ((now 4000)
                   (ov (make-notify-floating-overlay #:anchor 'top-right
                                                     #:max-visible 2
                                                     #:max-width 40
                                                     #:clock (lambda () now)))
                   (lines '())
                   (ctx `((draw-ops! . ,(lambda (ops _rect)
                                          (set! lines (render-ops->lines ops 80 24)))))))
              (test-equal "overlay kind is floating" 'floating (overlay-kind ov))
              (test-equal "floating on-key passes" 'pass ((overlay-on-key ov) ov 65 '()))
              (test-equal "floating on-click returns #f" #f ((overlay-on-click ov) ov '(row . 1) '()))
              (test-equal "renders #f when no active toasts"
                          #f
                          ((overlay-render ov) ov ctx 24 80 20))
              (notify-progress! "job-1" "Syncing..." #:title "Updater" #:now 4000)
              (test-equal "renders #t when toast active"
                          #t
                          ((overlay-render ov) ov ctx 24 80 20))
              (let ((txt (string-join lines "\n")))
                (test-assert "renders title" (string-contains txt "Updater"))
                (test-assert "renders message" (string-contains txt "Syncing...")))
              (notify-resolve! "job-1" "Synced" #:level 'info #:now 4001)
              (set! now 4006)
              (test-equal "expires toast on tick via clock"
                          #f
                          ((overlay-render ov) ov ctx 24 80 20)))
            (clear-notifications!))

(test-group "notifications-modal-and-registration"
            (clear-notifications!)
            (let* ((now 5000)
                   (clk (lambda () now)))
              (notify-info! "Alpha ready" #:title "Core" #:source "tui" #:now 4990)
              (notify-error! "Beta failed" #:title "Net" #:source "mcp" #:now 4995)
              (let* ((ov (make-notifications-modal-overlay #:clock clk))
                     (lines '())
                     (closed? #f)
                     (draw-ctx `((draw-ops! . ,(lambda (ops _rect)
                                                 (set! lines (render-ops->lines ops 90 26))))))
                     (key-ctx `((key-up . 259)
                                (key-down . 258)
                                (key-enter . 10)
                                (key-backspace . 263)
                                (on-close! . ,(lambda () (set! closed? #t))))))
                ((overlay-render ov) ov draw-ctx 26 90 0)
                (let ((txt (string-join lines "\n")))
                  (test-assert "modal title shown" (string-contains txt "Notifications"))
                  (test-assert "shows Beta failed" (string-contains txt "Beta failed"))
                  (test-assert "shows Alpha ready" (string-contains txt "Alpha ready")))
                ((overlay-on-key ov) ov (char->integer #\/) key-ctx)
                ((overlay-on-key ov) ov (char->integer #\A) key-ctx)
                ((overlay-on-key ov) ov (char->integer #\l) key-ctx)
                ((overlay-on-key ov) ov 10 key-ctx)
                ((overlay-render ov) ov draw-ctx 26 90 0)
                (let ((txt (string-join lines "\n")))
                  (test-assert "filter keeps Alpha" (string-contains txt "Alpha ready"))
                  (test-assert "filter hides Beta" (not (string-contains txt "Beta failed"))))
                (test-equal "first Esc clears filter" 'handled ((overlay-on-key ov) ov 27 key-ctx))
                (test-assert "not closed on first Esc" (not closed?))
                (test-equal "second Esc closes modal" 'close ((overlay-on-key ov) ov 27 key-ctx))
                (test-assert "closed on second Esc" closed?)
                (let ((ov2 (make-notifications-modal-overlay #:clock clk)))
                  ((overlay-on-key ov2) ov2 (char->integer #\c) key-ctx)
                  (test-equal "c clears history" 0 (length (notify-history))))))
            (let ((cats '())
                  (cmds '())
                  (opened #f))
              (register-notifications-tui!
                #:register-category! (lambda (path desc) (set! cats (cons (cons path desc) cats)))
                #:register-command! (lambda (name desc handler . _rest)
                                      (set! cmds (cons (list name desc handler) cmds)))
                #:open-overlay! (lambda (ov) (set! opened ov)))
              (test-assert "category registered" (pair? cats))
              (let ((cmd (assoc "notifications" cmds)))
                (test-assert "notifications command registered" cmd)
                ((caddr cmd))
                (test-assert "command opens modal overlay" (modal-overlay? opened))))
            (clear-notifications!))

(spec-end)
(spec-exit)
